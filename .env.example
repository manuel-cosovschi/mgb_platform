# ─────────────────────────────────────────────
# MGB Hub — Variables de entorno
# Copiar como .env y completar con los valores reales
# ─────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mgb_hub?sslmode=require"

# NextAuth
# Generar con: openssl rand -base64 32
AUTH_SECRET="tu-secret-super-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional)
# Crear en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (opcional, para archivos)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# S3 / AWS (alternativa a Supabase Storage)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@mgb.dev"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
